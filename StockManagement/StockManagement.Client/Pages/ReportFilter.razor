@using StockManagement.Models
@using Microsoft.AspNetCore.Components.Forms
@inherits ReportFilterBase

<div class="card mb-3">
    <div class="card-header" style="cursor:pointer"
         @onclick="ToggleFilters">
        <strong>Filters</strong>
        <span class="float-end">
            <i class="bi @(filtersExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
        </span>
    </div>
    @if (filtersExpanded)
    {
        <div class="card-body">
            @{
                var colClass = ShowReportTypeSelector ? "col-lg-3" : "col-lg-4";
            }
            <div class="row">
                @if (ShowReportTypeSelector)
                {
                    <div class="@colClass">
                        <div class="form-floating">
                            <InputSelect id="reportTypeFilter" @bind-Value="SalesReportType" TValue="int" class="form-control">
                                <option value="1">Location</option>
                                <option value="2">Customer</option>
                            </InputSelect>
                            <label for="reportTypeFilter">Group By:</label>
                        </div>
                    </div>
                }
                @if (!ShowReportTypeSelector || SalesReportType == 1)
                {
                    <div class="@colClass">
                        <div class="form-floating">
                            <InputSelect id="locationFilter" @bind-Value="LocationId" TValue="int" class="form-control">
                                <option value="-1">-- Totals --</option>
                                <option value="0">All Locations</option>
                                @if (Lookups?.LocationList != null)
                                {
                                    @foreach (var location in Lookups.LocationList)
                                    {
                                        <option value="@location.Id">@location.Name</option>
                                    }
                                }
                            </InputSelect>
                            <label for="locationFilter">Location:</label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="@colClass">
                        <div class="form-floating">
                            <InputSelect id="customerFilter" @bind-Value="CustomerId" TValue="int" class="form-control">
                                <option value="-1">-- Totals --</option>
                                <option value="0">All Customers</option>
                                @if (Lookups?.CustomerList != null)
                                {
                                    @foreach (var customer in Lookups.CustomerList)
                                    {
                                        <option value="@customer.Id">@customer.Name</option>
                                    }
                                }
                            </InputSelect>
                            <label for="customerFilter">Customer:</label>
                        </div>
                    </div>
                }
                <div class="@colClass">
                    <div class="form-floating">
                        <InputSelect id="productTypeFilter" @bind-Value="ProductTypeId" TValue="int" class="form-control">
                            <option value="0">All Product Types</option>
                            @if (Lookups?.ProductTypeList != null)
                            {
                                @foreach (var productType in Lookups.ProductTypeList)
                                {
                                    <option value="@productType.Id">@productType.ProductTypeName</option>
                                }
                            }
                        </InputSelect>
                        <label for="productTypeFilter">Product Type:</label>
                    </div>
                </div>
                <div class="@colClass">
                    <div class="form-floating">
                        <InputSelect id="productFilter" @bind-Value="ProductId" TValue="int" class="form-control">
                            <option value="0">All Products</option>
                            @if (Lookups?.ProductList != null)
                            {
                                @foreach (var product in Lookups.ProductList)
                                {
                                    <option value="@product.Id">@product.ProductName</option>
                                }
                            }
                        </InputSelect>
                        <label for="productFilter">Product:</label>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
