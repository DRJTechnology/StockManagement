@page "/stock-valuation"
@layout MainLayoutClient
@using StockManagement.Client.Components.Finance
@using StockManagement.Client.Shared
@inherits StockValuationReportBase
@rendermode InteractiveWebAssembly
<PageTitle>Stock Valuation</PageTitle>

<h3>Stock Valuation</h3>
<p class="text-muted mb-2">As at @ToDate.ToString("d MMMM yyyy")</p>

<ReportPeriodFilter @bind-FromDate="FromDate" @bind-ToDate="ToDate" ShowFromDate="false"
                    PdfUrl="@PdfUrl" OnChanged="ReloadAsync" />

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (!Items.Any())
{
    <p>No stock held at this date.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Product Type</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Cost</th>
                    <th class="text-end">Market value</th>
                </tr>
            </thead>
            @foreach (var location in ByLocation)
            {
                <tbody>
                    <tr class="table-light"><th colspan="5">@location.Key</th></tr>
                    @foreach (var item in location)
                    {
                        <tr>
                            <td>@item.ProductTypeName</td>
                            <td>@item.ProductName</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.CostValue.ToString("C")</td>
                            <td class="text-end">@item.MarketValue.ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-bold">
                        <td colspan="2">@location.Key total</td>
                        <td class="text-end">@location.Sum(i => i.Quantity)</td>
                        <td class="text-end">@location.Sum(i => i.CostValue).ToString("C")</td>
                        <td class="text-end">@location.Sum(i => i.MarketValue).ToString("C")</td>
                    </tr>
                </tbody>
            }
            <tfoot>
                <tr class="fw-bold border-top border-2 fs-5">
                    <td colspan="2">Closing stock at cost</td>
                    <td class="text-end">@TotalQuantity</td>
                    <td class="text-end">@TotalCost.ToString("C")</td>
                    <td class="text-end">@TotalMarket.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (NilCostQuantity > 0)
    {
        <div class="alert alert-warning">
            <strong>@NilCostQuantity item(s) are held at nil cost</strong>
            (market value @NilCostMarketValue.ToString("C")). These are items with no
            purchase cost recorded &mdash; typically original works where the materials
            were expensed as they were bought. Stock is normally carried at the lower of
            cost and net realisable value, so this is a point for the accountant to
            confirm.
        </div>
    }
}
