@page "/year-end-checks"
@layout MainLayoutClient
@using StockManagement.Client.Components.Finance
@using StockManagement.Client.Shared
@using StockManagement.Models.Dto.Finance
@inherits YearEndChecksReportBase
@rendermode InteractiveWebAssembly
<PageTitle>Year End Checks</PageTitle>

<h3>Year End Checks</h3>
<p class="text-muted mb-2">@PeriodLabel</p>

<ReportPeriodFilter @bind-FromDate="FromDate" @bind-ToDate="ToDate"
                    PdfUrl="@PdfUrl" OnChanged="ReloadAsync" />

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <strong>Accounts pack for the accountant</strong>
            <div class="text-muted small">
                Profit and Loss, Balance Sheet, Trial Balance, Stock Valuation, Stock
                Reconciliation, Income and Expenditure, Owner's Account, Nominal Ledger
                and these checks, as one PDF.
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="@PackUrl(AccountingBasis.Accruals)" target="_blank">
                <span class="bi bi-file-earmark-pdf" aria-hidden="true"></span> Accruals pack
            </a>
            <a class="btn btn-outline-primary" href="@PackUrl(AccountingBasis.Cash)" target="_blank">
                <span class="bi bi-file-earmark-pdf" aria-hidden="true"></span> Cash basis pack
            </a>
        </div>
    </div>
</div>

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (!Items.Any())
{
    <div class="alert alert-success">
        No cut-off issues found. Nothing straddles the year end, every confirmed sale
        has been paid, and all stock paid for has been received.
    </div>
}
else
{
    @if (ActionCount > 0)
    {
        <div class="alert alert-warning">
            <strong>@ActionCount item(s) need attention</strong> before these accounts
            are finalised.
        </div>
    }

    @foreach (var check in ByCheckType)
    {
        <h5 class="mt-4">@check.Key</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th style="width:6rem">Severity</th>
                        <th>Details</th>
                        <th style="width:7rem">Date</th>
                        <th style="width:7rem">Other date</th>
                        <th class="text-end" style="width:8rem">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in check)
                    {
                        <tr class="@RowClass(item)">
                            <td>@item.Severity</td>
                            <td>@item.Details</td>
                            <td>@(item.Date1.HasValue ? item.Date1.Value.ToString("dd/MM/yyyy") : "")</td>
                            <td>@(item.Date2.HasValue ? item.Date2.Value.ToString("dd/MM/yyyy") : "")</td>
                            <td class="text-end">@item.Amount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
