@page "/profit-and-loss"
@layout MainLayoutClient
@using StockManagement.Client.Components.Finance
@using StockManagement.Client.Shared
@using StockManagement.Models.Dto.Finance
@inherits ProfitAndLossReportBase
@rendermode InteractiveWebAssembly
<PageTitle>Profit and Loss</PageTitle>

<h3>Profit and Loss</h3>
<p class="text-muted mb-2">@PeriodLabel &mdash; @BasisLabel</p>

<ReportPeriodFilter @bind-FromDate="FromDate" @bind-ToDate="ToDate" @bind-Basis="Basis"
                    ShowBasis="true" PdfUrl="@PdfUrl" OnChanged="ReloadAsync" />

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (!Items.Any())
{
    <p>No transactions in this period.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Account</th>
                    <th class="text-end" style="width:10rem">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr class="table-light"><th colspan="2">Income</th></tr>
                @foreach (var item in Section(1))
                {
                    <tr>
                        <td class="ps-4">@item.AccountName</td>
                        <td class="text-end">@item.Amount.ToString("C")</td>
                    </tr>
                }
                <tr class="fw-bold border-top">
                    <td>Turnover</td>
                    <td class="text-end">@Income.ToString("C")</td>
                </tr>

                @if (Section(2).Any())
                {
                    <tr class="table-light"><th colspan="2">Cost of Sales</th></tr>
                    @foreach (var item in Section(2))
                    {
                        <tr>
                            <td class="ps-4">@item.AccountName</td>
                            <td class="text-end">(@item.Amount.ToString("C"))</td>
                        </tr>
                    }
                    <tr class="fw-bold border-top">
                        <td>Gross profit</td>
                        <td class="text-end">@GrossProfit.ToString("C")</td>
                    </tr>
                }

                @if (Section(3).Any())
                {
                    <tr class="table-light"><th colspan="2">Expenses</th></tr>
                    @foreach (var item in Section(3))
                    {
                        <tr>
                            <td class="ps-4">@item.AccountName</td>
                            <td class="text-end">(@item.Amount.ToString("C"))</td>
                        </tr>
                    }
                    <tr class="fw-bold border-top">
                        <td>Total expenses</td>
                        <td class="text-end">(@Expenses.ToString("C"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold border-top border-2 fs-5">
                    <td>Net @(NetProfit >= 0 ? "profit" : "loss")</td>
                    <td class="text-end">@NetProfit.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (Basis == AccountingBasis.Cash)
    {
        <div class="alert alert-info">
            On the cash basis, stock is expensed when it is paid for. Cost of goods sold,
            stock written off, stock used for promotion and stock taken for own use are
            excluded, and no closing stock is carried on the Balance Sheet.
        </div>
    }
}
