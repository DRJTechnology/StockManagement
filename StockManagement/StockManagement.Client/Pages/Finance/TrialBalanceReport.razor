@page "/trial-balance"
@layout MainLayoutClient
@using StockManagement.Client.Components.Finance
@using StockManagement.Client.Shared
@inherits TrialBalanceReportBase
@rendermode InteractiveWebAssembly
<PageTitle>Trial Balance</PageTitle>

<h3>Trial Balance</h3>
<p class="text-muted mb-2">@PeriodLabel</p>

<ReportPeriodFilter @bind-FromDate="FromDate" @bind-ToDate="ToDate"
                    PdfUrl="@PdfUrl" OnChanged="ReloadAsync" />

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (!Items.Any())
{
    <p>No transactions in this period.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Type</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Balance Dr</th>
                    <th class="text-end">Balance Cr</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        <td>@item.AccountName</td>
                        <td>@item.AccountType</td>
                        <td class="text-end">@(item.Debit > 0 ? item.Debit.ToString("C") : "")</td>
                        <td class="text-end">@(item.Credit > 0 ? item.Credit.ToString("C") : "")</td>
                        <td class="text-end">@(item.BalanceDebit > 0 ? item.BalanceDebit.ToString("C") : "")</td>
                        <td class="text-end">@(item.BalanceCredit > 0 ? item.BalanceCredit.ToString("C") : "")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold border-top border-2">
                    <td colspan="2">Total</td>
                    <td class="text-end">@TotalDebit.ToString("C")</td>
                    <td class="text-end">@TotalCredit.ToString("C")</td>
                    <td class="text-end">@TotalBalanceDebit.ToString("C")</td>
                    <td class="text-end">@TotalBalanceCredit.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (!Balances)
    {
        <div class="alert alert-danger">
            <strong>The trial balance does not balance.</strong>
            Debits of @TotalDebit.ToString("C") do not agree to credits of
            @TotalCredit.ToString("C"). A transaction is missing one side.
        </div>
    }
}
