@page "/balance-sheet"
@layout MainLayoutClient
@using StockManagement.Client.Components.Finance
@using StockManagement.Client.Shared
@using StockManagement.Models.Dto.Finance
@inherits BalanceSheetReportBase
@rendermode InteractiveWebAssembly
<PageTitle>Balance Sheet</PageTitle>

<h3>Balance Sheet</h3>
<p class="text-muted mb-2">As at @ToDate.ToString("d MMMM yyyy") &mdash; @BasisLabel</p>

<ReportPeriodFilter @bind-FromDate="FromDate" @bind-ToDate="ToDate" @bind-Basis="Basis"
                    ShowBasis="true" PdfUrl="@PdfUrl" OnChanged="ReloadAsync" />

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (!Items.Any())
{
    <p>No balances at this date.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Account</th>
                    <th class="text-end" style="width:10rem">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var section in new[] { 1, 2, 3 })
                {
                    @if (Section(section).Any())
                    {
                        <tr class="table-light">
                            <th colspan="2">@Section(section).First().Section</th>
                        </tr>
                        @foreach (var item in Section(section))
                        {
                            <tr>
                                <td class="ps-4">@item.AccountName</td>
                                <td class="text-end">@item.Amount.ToString("C")</td>
                            </tr>
                        }
                    }
                }
                <tr class="fw-bold border-top border-2">
                    <td>Net assets</td>
                    <td class="text-end">@NetAssets.ToString("C")</td>
                </tr>

                <tr class="table-light"><th colspan="2">Capital</th></tr>
                @foreach (var item in Section(4))
                {
                    <tr>
                        <td class="ps-4">@item.AccountName</td>
                        <td class="text-end">@item.Amount.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold border-top border-2 fs-5">
                    <td>Total capital</td>
                    <td class="text-end">@TotalCapital.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (!Balances)
    {
        <div class="alert alert-danger">
            <strong>This balance sheet does not balance.</strong>
            Net assets of @NetAssets.ToString("C") do not agree to total capital of
            @TotalCapital.ToString("C"), a difference of
            @((NetAssets - TotalCapital).ToString("C")). Check the Trial Balance for a
            transaction that is missing one side before sending these accounts out.
        </div>
    }

    @if (Basis == AccountingBasis.Cash)
    {
        <div class="alert alert-info">
            On the cash basis, stock is expensed when it is paid for, so no closing
            stock is carried here. With no business bank account, the business holds
            no assets and net assets are nil.
        </div>
    }
    else
    {
        <InventoryValue />
    }
}
